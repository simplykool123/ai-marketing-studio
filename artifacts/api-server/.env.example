# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "URI" format with the connection pooler (port 6543) for production,
# or the direct connection (port 5432) for local migrations / drizzle-kit push.
#
# Direct connection (for drizzle-kit push / migrations):
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Pooled connection (for the running API — use pgBouncer/pooler URL):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# ─── Supabase (Auth + Storage) ────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # "service_role" secret (NOT the anon key)

# ─── AI Providers ─────────────────────────────────────────────────────────────
# At least one AI key is required for content generation.
ANTHROPIC_KEY=sk-ant-...
OPENAI_KEY=sk-...
GEMINI_KEY=AIza...

# ─── Security ────────────────────────────────────────────────────────────────
# Any random 32+ character string — used to encrypt stored OAuth tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars

# ─── OAuth / Social Platforms (all optional) ─────────────────────────────────
# Leave blank to disable the social account OAuth flow for that platform.
# Callback URL pattern: https://your-domain.com/api/oauth/callback/<platform>

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
