# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "URI" format with the connection pooler (port 6543) for production,
# or the direct connection (port 5432) for local migrations / drizzle-kit push.
#
# Direct connection (for drizzle-kit push / migrations):
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Pooled connection (for the running API — use pgBouncer/pooler URL):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# ─── Supabase (Auth + Storage) ────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # "service_role" secret (NOT the anon key)

# ─── AI Providers ─────────────────────────────────────────────────────────────
# At least one AI key is required for content generation.
ANTHROPIC_KEY=sk-ant-...
OPENAI_KEY=sk-...
GEMINI_KEY=AIza...

# Optional video provider gateway for backend-only video generation tests.
FAL_KEY=

# ─── Security ────────────────────────────────────────────────────────────────
# Base64-encoded 32+ byte secret used to encrypt stored OAuth tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-secret

# ─── OAuth / Social Platforms (all optional) ─────────────────────────────────
# Leave blank to disable the social account OAuth flow for that platform.
# Meta OAuth V1 connects a Facebook Page and any linked Instagram Business/Creator account.
# Local callback example: http://localhost:8080/api/auth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8080/api/auth/meta/callback
META_GRAPH_VERSION=v18.0

# Legacy per-platform OAuth envs are still supported as fallbacks.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
